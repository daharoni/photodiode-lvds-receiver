			(at 45.72 254 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
	)
	(text "Global net GND enters here only to carry a PWR_FLAG for ERC. The Controller is the ESP32-C6 sheet (decision 11); the MCU sheet is gone.\nHOLD_N is a plain wire: Connector -> Control (buffered on the Connector sheet). HV_MON is Power -> Controller and Connector; DAC_HV and HV_DIS are Controller -> Power.\nThe Control hierarchical pin LOS is the active-low net LOS_N on the Control sheet. CAN_H, CAN_L and AUX run Controller <-> Connector."
		(exclude_from_sim yes)
		(at 25.4 262 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "3e5167b3-0995-436c-90c9-0135efd1fb11")
	)
