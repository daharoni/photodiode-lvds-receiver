	(text "U5 TPS2121 source mux (PROPOSED; SLVSEA3F pin table p.4-5,\nTable 9-3 p.18, ST p.18, ILM p.13): cable priority, USB-C VBUS\nfallback. PR1 divider R35/R36, OV1 R39/R40, OV2 R41/R42 (VBUS).\nILM R38 100k (1.24 A typ; minimum at 100k UNRESOLVED), SS C32 220 nF.\nST low = USB powers the module (PWR_SRC). Not simulated or measured."
		(exclude_from_sim yes)
		(at 20 52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75849b43-d7a4-4fb5-afc0-b2dd45cf8803")
	)
