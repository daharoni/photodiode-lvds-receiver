	(text "Slicer: SDET_P is compared with the VCM_REF baseline (SDET_N, trimmed by DAC_TH) in a TLV3605 with 3 mV external hysteresis; LVDS out."
		(exclude_from_sim yes)
		(at 101.6 30.48 0)
