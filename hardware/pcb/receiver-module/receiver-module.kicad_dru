(version 1)

# Custom DRC rules, Rev A, JLCPCB 6-layer JLC06161H-3313. All values PROPOSED
# (docs/pcb/jlcpcb-fab-settings.md section 4.5). Later rules take precedence over
# earlier ones, so the same-footprint exception is the LAST HV clearance rule.

# 90 ohm pairs (DIFF90 = SuperSpeed/LVDS_OUT, USB90, CAN90): gap window around the 0.15 mm target
(rule "diff90 gap"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90')")
  (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.20mm)))

# 100 ohm LVDS pair (U20 to R180)
(rule "diff100 gap"
  (condition "A.hasNetclass('DIFF100')")
  (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.20mm)))

# uncoupled length: 10 mm for connector fan-out pairs, 5 mm for the short LVDS run
(rule "diff90 uncoupled"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90')")
  (constraint diff_pair_uncoupled (max 10mm)))
(rule "diff100 uncoupled"
  (condition "A.hasNetclass('DIFF100')")
  (constraint diff_pair_uncoupled (max 5mm)))

# intra-pair skew 1 mm (UI = 20 ns)
(rule "pair skew"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90') || A.hasNetclass('DIFF100')")
  (constraint skew (max 1mm)))

# Keep copper that is not part of the pair at least 0.3 mm from the pair's tracks.
# Netclass form (works for USB_DP/CAN_H even though KiCad does not pair those names):
(rule "pair keepout DIFF90"
  (condition "A.Type == 'Track' && A.hasNetclass('DIFF90') && !B.hasNetclass('DIFF90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout USB90"
  (condition "A.Type == 'Track' && A.hasNetclass('USB90') && !B.hasNetclass('USB90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout CAN90"
  (condition "A.Type == 'Track' && A.hasNetclass('CAN90') && !B.hasNetclass('CAN90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout DIFF100"
  (condition "A.Type == 'Track' && A.hasNetclass('DIFF100') && !B.hasNetclass('DIFF100')")
  (constraint clearance (min 0.3mm)))
# Name-paired form (catches pair-to-pair, e.g. LVDS_OUT1 vs LVDS_OUT2, which share a class):
(rule "pair keepout inDiffPair"
  (condition "A.Type == 'Track' && A.inDiffPair('*') && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.3mm)))

# HV copper (class HV, 1.0 mm from the netclass) to board edge
(rule "hv edge"
  (condition "A.hasNetclass('HV') || A.hasNetclass('HV_LADDER')")
  (constraint edge_clearance (min 1.0mm)))

# Exposed HV pads versus copper of another net: IPC-2221B B2, 171-250 V uncoated = 1.25 mm
# (secondary source, see doc section 4.4). Zones excluded (they use the netclass 1.0 mm).
(rule "hv pad clearance"
  (condition "A.hasNetclass('HV') && A.Type == 'Pad' && B.Net != A.Net && B.Type != 'Zone'")
  (constraint clearance (min 1.25mm)))

# EXCEPTION (must stay last): two pads of the SAME footprint (Q1, Q2, D3, D4, D10, D11, U3, R/C bodies) cannot be
# spaced by the layout, the part's own pad gap applies. Everything outside one footprint keeps the HV/HV_LADDER clearance.
(rule "hv same footprint pads"
  (condition "(A.hasNetclass('HV') || B.hasNetclass('HV') || A.hasNetclass('HV_LADDER') || B.hasNetclass('HV_LADDER')) && A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
  (constraint clearance (min 0.15mm)))
