(version 1)

# Custom DRC rules, Rev A, JLCPCB 6-layer JLC06161H-3313. All values PROPOSED
# (docs/pcb/jlcpcb-fab-settings.md section 4.5). Later rules take precedence over
# earlier ones, so the same-footprint exception is the LAST HV clearance rule.

# 90 ohm pairs (DIFF90 = SuperSpeed/LVDS_OUT, USB90, CAN90): gap window around the 0.15 mm target
(rule "diff90 gap"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90')")
  (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.20mm)))

# 100 ohm LVDS pair (U20 to R180)
(rule "diff100 gap"
  (condition "A.hasNetclass('DIFF100')")
  (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.20mm)))

# uncoupled length: 10 mm for connector fan-out pairs, 5 mm for the short LVDS run
(rule "diff90 uncoupled"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90')")
  (constraint diff_pair_uncoupled (max 10mm)))
(rule "diff100 uncoupled"
  (condition "A.hasNetclass('DIFF100')")
  (constraint diff_pair_uncoupled (max 5mm)))

# intra-pair skew 1 mm (UI = 20 ns)
(rule "pair skew"
  (condition "A.hasNetclass('DIFF90') || A.hasNetclass('CAN90') || A.hasNetclass('USB90') || A.hasNetclass('DIFF100')")
  (constraint skew (max 1mm)))

# Keep copper that is not part of the pair at least 0.3 mm from the pair's tracks.
# Netclass form (works for USB_DP/CAN_H even though KiCad does not pair those names):
(rule "pair keepout DIFF90"
  (condition "A.Type == 'Track' && A.hasNetclass('DIFF90') && !B.hasNetclass('DIFF90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout USB90"
  (condition "A.Type == 'Track' && A.hasNetclass('USB90') && !B.hasNetclass('USB90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout CAN90"
  (condition "A.Type == 'Track' && A.hasNetclass('CAN90') && !B.hasNetclass('CAN90')")
  (constraint clearance (min 0.3mm)))
(rule "pair keepout DIFF100"
  (condition "A.Type == 'Track' && A.hasNetclass('DIFF100') && !B.hasNetclass('DIFF100')")
  (constraint clearance (min 0.3mm)))
# Name-paired form (catches pair-to-pair, e.g. LVDS_OUT1 vs LVDS_OUT2, which share a class):
(rule "pair keepout inDiffPair"
  (condition "A.Type == 'Track' && A.inDiffPair('*') && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.3mm)))

# HV copper (class HV, 1.0 mm from the netclass) to board edge
(rule "hv edge"
  (condition "A.hasNetclass('HV') || A.hasNetclass('HV_LADDER')")
  (constraint edge_clearance (min 1.0mm)))

# Exposed HV pads versus copper of another net: IPC-2221B B2, 171-250 V uncoated = 1.25 mm
# (secondary source, see doc section 4.4). Zones excluded (they use the netclass 1.0 mm).
(rule "hv pad clearance"
  (condition "A.hasNetclass('HV') && A.Type == 'Pad' && B.Net != A.Net && B.Type != 'Zone'")
  (constraint clearance (min 1.25mm)))

# J50 (Wuerth 632723300011) B-row through-holes: 0.65 mm pads / 0.40 mm drills at 0.8 mm pitch as drawn by WE
# (annular 0.125 mm, hole-to-hole 0.40 mm, hole-to-copper 0.275 mm). JLCPCB's DFM accepted this footprint under the
# quote option "Min via hole size/diameter" = 0.25mm/(0.35/0.4mm) (auto-adds 4-Wire Kelvin Test and FR4 Tg155)
# (Daniel, 2026-10-09, test board hardware/pcb/j50-dfm-test). Order the board with that option.
# Waived for J50 only; every other footprint keeps the standard-tier minima.
(rule "j50 annular"
  (condition "A.memberOfFootprint('J50')")
  (constraint annular_width (min 0.12mm)))
(rule "j50 hole to hole"
  (condition "A.memberOfFootprint('J50') && B.memberOfFootprint('J50')")
  (constraint hole_to_hole (min 0.38mm)))
(rule "j50 hole clearance"
  (condition "A.memberOfFootprint('J50') && B.memberOfFootprint('J50')")
  (constraint hole_clearance (min 0.27mm)))

# EXCEPTION (must stay last): two pads of the SAME footprint (Q1, Q2, D3, D4, D10, D11, U3, R/C bodies) cannot be
# spaced by the layout, the part's own pad gap applies. Everything outside one footprint keeps the HV/HV_LADDER clearance.
(rule "hv same footprint pads"
  (condition "(A.hasNetclass('HV') || B.hasNetclass('HV') || A.hasNetclass('HV_LADDER') || B.hasNetclass('HV_LADDER')) && A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
  (constraint clearance (min 0.15mm)))

# EXCEPTION (must stay last): a track escaping a pad of an HV footprint runs inside that footprint's courtyard,
# closer than the HV clearance to the part's other pads (and to a neighbouring escape track). The part's own pad
# gap applies there, as in "hv same footprint pads". Without this the router refuses to start on those pads
# ("The routing start point violates DRC"). Outside the courtyard the 1.0 mm netclass / 1.25 mm pad rules apply.
(rule "hv escape inside own courtyard"
  (condition "A.Type == 'Track' && (B.Type == 'Pad' || B.Type == 'Track') && (((B.memberOfFootprint('U3') || B.intersectsCourtyard('U3')) && A.intersectsCourtyard('U3')) || ((B.memberOfFootprint('D1') || B.intersectsCourtyard('D1')) && A.intersectsCourtyard('D1')) || ((B.memberOfFootprint('D2') || B.intersectsCourtyard('D2')) && A.intersectsCourtyard('D2')) || ((B.memberOfFootprint('D3') || B.intersectsCourtyard('D3')) && A.intersectsCourtyard('D3')) || ((B.memberOfFootprint('D4') || B.intersectsCourtyard('D4')) && A.intersectsCourtyard('D4')) || ((B.memberOfFootprint('D10') || B.intersectsCourtyard('D10')) && A.intersectsCourtyard('D10')) || ((B.memberOfFootprint('Q1') || B.intersectsCourtyard('Q1')) && A.intersectsCourtyard('Q1')) || ((B.memberOfFootprint('Q2') || B.intersectsCourtyard('Q2')) && A.intersectsCourtyard('Q2')) || ((B.memberOfFootprint('R7') || B.intersectsCourtyard('R7')) && A.intersectsCourtyard('R7')) || ((B.memberOfFootprint('R11') || B.intersectsCourtyard('R11')) && A.intersectsCourtyard('R11')) || ((B.memberOfFootprint('R16') || B.intersectsCourtyard('R16')) && A.intersectsCourtyard('R16')) || ((B.memberOfFootprint('R17') || B.intersectsCourtyard('R17')) && A.intersectsCourtyard('R17')) || ((B.memberOfFootprint('R18') || B.intersectsCourtyard('R18')) && A.intersectsCourtyard('R18')) || ((B.memberOfFootprint('R20') || B.intersectsCourtyard('R20')) && A.intersectsCourtyard('R20')))")
  (constraint clearance (min 0.15mm)))
