# ulx3s_top smoke test (see test_top.py). Run by the top-level `make test` (entry "system top smoke").
SIM ?= icarus
TOPLEVEL_LANG = verilog
SIM_BUILD = sim_build_top
COCOTB_RESULTS_FILE = results_top.xml
R = $(PWD)/../../rtl
VERILOG_SOURCES = $(wildcard $(R)/*.v)
TOPLEVEL = ulx3s_top
COMPILE_ARGS += -Pulx3s_top.FTDI_DEBOUNCE=100 -Pulx3s_top.ASCII_PERIOD=20000
COCOTB_TEST_MODULES = test_top
export PYTHONPATH := $(PWD)/../..:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim

.PHONY: check
check:
	@! grep -q -E '<(failure|error)' results_top.xml || { echo "system top smoke: FAILED"; exit 1; }
	@grep -q '<testcase' results_top.xml || { echo "system top smoke: no tests ran"; exit 1; }
